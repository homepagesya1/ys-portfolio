---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, services } from "../../data/registry";

const latestProjects = projects.slice(0, 3);
const topServices = services.slice(0, 2);

const statusLabels: Record<string, string> = {
  live: "Live",
  upcoming: "Bald verfügbar",
  active: "Aktiv",
  wip: "In Entwicklung",
};
---

<BaseLayout title="Home" lang="en">
  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-inner">
        <span class="section-label">Web Creator & Developer</span>
        <h1 class="hero-h1">
          Building<br />
          digital<br />
          <em>experiences.</em>
        </h1>
        <p class="hero-sub">
          I'm Yannick — I craft clean, functional websites and apps. From UI
          design to server setups, I bring ideas to life with code and attention
          to detail.
        </p>
        <div class="hero-btns">
          <a href="/en/about" class="btn-primary">About</a>
          <a href="/en/services" class="btn-outline">Services</a>
        </div>
      </div>

      <!-- Honeycomb — 11 Hexe, 12 Slots, JS-gesteuert -->
      <div class="hc" id="hc-hero-en" style="position: relative;">
        <div class="hex hex--accent" data-id="1">
          <span class="hex-label hex-label--accent">YS.</span>
        </div>
        <div class="hex hex--a" data-id="2">
          <span class="hex-label">Web Dev</span>
        </div>
        <div class="hex hex--b" data-id="3"></div>
        <div class="hex hex--c" data-id="4"></div>
        <div class="hex hex--a" data-id="5"></div>
        <div class="hex hex--b" data-id="6">
          <span class="hex-label">UI/UX</span>
        </div>
        <div class="hex hex--c" data-id="7"></div>
        <div class="hex hex--b" data-id="8"></div>
        <div class="hex hex--a" data-id="9"></div>
        <div class="hex hex--c" data-id="10"></div>
        <div class="hex hex--b" data-id="11"></div>
        <!-- Slot 12 leer -->
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ==================== SERVICES TEASER ==================== -->
  <section class="home-section container">
    <div class="section-head">
      <div>
        <span class="section-label">What I offer</span>
        <h2>Built for you.</h2>
        <p class="section-sub">
          From full website creation to cloud office solutions — tailored and
          professional.
        </p>
      </div>
      <a href="/en/services" class="btn-outline view-all-btn"
        >View all services →</a
      >
    </div>

    <div class="card-grid">
      {
        topServices.map((sv) => (
          <a href={`/de/services/${sv.slug}`} class="card">
            <span class="card-tag">Service</span>
            <h3>{sv.en.title}</h3>
            <p class="card-excerpt">{sv.en.excerpt}</p>
            <span class="card-arrow">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ==================== PROJECTS TEASER ==================== -->
  <section class="home-section container">
    <div class="section-head">
      <div>
        <span class="section-label">Recent work</span>
        <h2>Latest Projects.</h2>
        <p class="section-sub">A selection of things I've built recently.</p>
      </div>
      <a href="/en/projects" class="btn-outline view-all-btn"
        >Alle View Projects →</a
      >
    </div>

    <div class="card-grid">
      {
        latestProjects.map((proj) => (
          <a href={`/de/projects/${proj.slug}`} class="card card--project">
            {proj.cover && (
              <div class="card-cover">
                <img src={proj.cover} alt={proj.en.title} loading="lazy" />
              </div>
            )}
            <div class="card-body">
              <span class="card-tag">{proj.en.area}</span>
              <h3>{proj.en.title}</h3>
              <p class="card-excerpt">{proj.en.excerpt}</p>
              <div class="card-foot">
                <span class={`badge badge-${proj.status}`}>
                  {statusLabels[proj.status]}
                </span>
                <span class="card-arrow-sm">↗</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 80px 0 56px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 56px;
    align-items: center;
  }

  .hero-inner {
    min-width: 0;
    padding-top: 50px;
  }

  .hero-h1 {
    font-size: clamp(44px, 7vw, 74px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 8px 0 22px;
  }
  .hero-h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero-sub {
    font-size: 17px;
    color: var(--muted);
    max-width: 420px;
    margin-bottom: 28px;
    line-height: 1.7;
  }
  .hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Honeycomb */
  .hc {
    width: 600px;
    height: 460px;
    flex-shrink: 0;
  }

  .hex {
    position: absolute;
    width: 150px;
    height: 130px;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform, left, top, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .hex--a {
    background: #1e2130;
  }
  .hex--b {
    background: #252837;
  }
  .hex--c {
    background: #2e3244;
  }
  .hex--accent {
    background: var(--accent);
  }

  :global([data-theme="light"]) .hex--a {
    background: #dedad4;
  }
  :global([data-theme="light"]) .hex--b {
    background: #e8e5df;
  }
  :global([data-theme="light"]) .hex--c {
    background: #cfc9c0;
  }

  .hex-label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    text-align: center;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
    opacity: 0.5;
  }
  .hex-label--accent {
    color: var(--bg);
    font-size: 30px;
    letter-spacing: -0.02em;
    opacity: 1;
  }

  /* Sections */
  .home-section {
    padding-block: 72px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 28px;
  }
  .section-head h2 {
    margin-bottom: 6px;
  }
  .section-sub {
    font-size: 15px;
    color: var(--muted);
    max-width: 360px;
  }
  .view-all-btn {
    font-size: 13px;
    padding: 9px 16px;
    flex-shrink: 0;
  }

  /* Cards */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition:
      border-color var(--trans),
      transform var(--trans);
  }
  .card:hover {
    border-color: var(--border-md);
    transform: translateY(-2px);
  }

  .card--project {
    padding: 0;
  }
  .card-cover {
    height: 180px;
    overflow: hidden;
  }
  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }
  .card:hover .card-cover img {
    transform: scale(1.04);
  }
  .card-body {
    padding: 20px 24px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-tag {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .card h3 {
    font-size: 17px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .card-excerpt {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    flex: 1;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
  }

  .card-arrow {
    position: absolute;
    top: 22px;
    right: 22px;
    font-size: 14px;
    color: var(--muted);
    transition: all var(--trans);
  }
  .card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .card-arrow-sm {
    font-size: 13px;
    color: var(--muted);
    transition: color var(--trans);
  }
  .card:hover .card-arrow-sm {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hc {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 48px 0 40px;
    }
    .hero-inner {
      padding-top: 24px;
    }
    .home-section {
      padding-block: 52px;
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const SLOTS: Record<number, { left: number; top: number }> = {
    1: { left: 113, top: 0 },
    2: { left: 0, top: 65 },
    3: { left: 113, top: 130 },
    4: { left: 113, top: 260 },
    5: { left: 226, top: 65 },
    6: { left: 339, top: 130 },
    7: { left: 226, top: 195 },
    8: { left: 226, top: 325 },
    9: { left: 339, top: 0 },
    10: { left: 339, top: 260 },
    11: { left: 452, top: 65 },
    12: { left: 452, top: 195 },
  };

  const hexSlot: Record<string, number> = {};
  let emptySlot = 12;
  const hexBusy: Record<string, boolean> = {};

  function placeInstant(el: HTMLElement, slot: number) {
    el.style.transition = "none";
    el.style.left = `${SLOTS[slot].left}px`;
    el.style.top = `${SLOTS[slot].top}px`;
    el.style.transform = "scale(0.91)";
    el.style.opacity = el.classList.contains("hex--c") ? "0.55" : "1";
    el.style.zIndex = "1";
    void el.offsetWidth;
  }

  function handleHover(hex: HTMLElement) {
    const id = hex.dataset.id!;
    if (hexBusy[id]) return;
    hexBusy[id] = true;

    const fromSlot = hexSlot[id];
    const toSlot = emptySlot;

    hexSlot[id] = toSlot;
    emptySlot = fromSlot;

    hex.style.transition = "transform 0.3s ease, opacity 0.25s ease";
    hex.style.transform = "scale(0.55)";
    hex.style.opacity = "0";

    setTimeout(() => {
      hex.style.transition = "none";
      hex.style.left = `${SLOTS[toSlot].left}px`;
      hex.style.top = `${SLOTS[toSlot].top}px`;
      void hex.offsetWidth;

      hex.style.transition =
        "transform 0.35s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.35s ease";
      hex.style.transform = "scale(0.91)";
      hex.style.opacity = hex.classList.contains("hex--c") ? "0.55" : "1";
      hex.style.zIndex = "1";

      setTimeout(() => {
        hexBusy[id] = false;
      }, 380);
    }, 280);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const hc = document.getElementById("hc-hero-en")!;
    const hexes = Array.from(hc.querySelectorAll<HTMLElement>(".hex"));

    hexes.forEach((hex, i) => {
      hexSlot[hex.dataset.id!] = i + 1;
      placeInstant(hex, i + 1);
    });

    hexes.forEach((hex) => {
      hex.addEventListener("mouseenter", () => handleHover(hex));
    });
  });
</script>
