---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="VA — Vertiefungsarbeit" lang="de">
  <div class="container">

    <a href="/de/projects" class="back-link">← Zurück zu Projekte</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <div>
        <span class="section-label">Vertiefungsarbeit</span>
        <h1>VA — Monitor Lampe</h1>
        <p class="hero-desc">
          Die Vertiefungsarbeit (VA) ist ein zentraler Bestandteil meiner Lehre als Informatiker EFZ.
          Ich erarbeite ein eigenes Projekt und dokumentiere es vollständig nach der Projektmethode
          <strong>IPERKA</strong>.
        </p>

        <div class="meta">
          <div class="meta-row">
            <span class="meta-label">Bereich</span>
            <span>Embedded Systems / Hardware</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Methode</span>
            <span>IPERKA</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Status</span>
            <span class="badge badge-wip">● In Planung</span>
          </div>
        </div>

        <div class="tags">
          <span class="chip">ESP32</span>
          <span class="chip">LED</span>
          <span class="chip">Hardware</span>
          <span class="chip">Elektronik</span>
        </div>
      </div>

      <div class="hero-summary">
        <span class="section-label">Projektidee</span>
        <h3>Monitor Lampe mit ESP32</h3>
        <p>
          Eine selbst gebaute Monitor-Lampe, gesteuert über einen ESP32. Helligkeit und Farbtemperatur
          werden über zwei Schieberegler eingestellt. Per Widerstandsknopf können die LEDs ein- und
          ausgeschaltet werden.
        </p>
        <div class="components">
          <div class="component component--done">
            <span class="comp-icon">✓</span>
            <div>
              <div class="comp-name">Lampenmaterial</div>
              <div class="comp-status">Gekauft</div>
            </div>
          </div>
          <div class="component component--pending">
            <span class="comp-icon">○</span>
            <div>
              <div class="comp-name">ESP32 Controller</div>
              <div class="comp-status">Noch zu besorgen</div>
            </div>
          </div>
          <div class="component component--pending">
            <span class="comp-icon">○</span>
            <div>
              <div class="comp-name">LED-Streifen</div>
              <div class="comp-status">Noch zu besorgen</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== IPERKA ===== -->
    <section class="section">
      <span class="section-label">Projektmethode</span>
      <h2>IPERKA</h2>
      <p class="section-sub">
        IPERKA ist eine strukturierte Projektmethode die in sechs Phasen unterteilt ist.
        Sie begleitet das Projekt von der ersten Information bis zur abschliessenden Auswertung.
      </p>
    </section>

    <!-- I — Informieren -->
    <div class="iperka-step iperka-step--done">
      <div class="step-marker">
        <div class="step-dot step-dot--done"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">I</span>
          <div>
            <h3>Informieren</h3>
            <span class="step-badge step-badge--done">Abgeschlossen</span>
          </div>
        </div>
        <div class="step-body">
          <p>
            In der Informationsphase habe ich mich über die Anforderungen der IPA (individuelle praktische
            Arbeit) informiert und die nötigen Grundlagen für mein Projekt erarbeitet.
          </p>
          <div class="info-blocks">
            <div class="info-block">
              <h4>IPA-Anforderungen</h4>
              <p>Recherche über Ablauf, Struktur und Bewertungskriterien der Vertiefungsarbeit.</p>
            </div>
            <div class="info-block">
              <h4>ESP32 Grundlagen</h4>
              <p>Einarbeitung in den Microcontroller ESP32 — Architektur, Programmierung und Einsatzmöglichkeiten.</p>
            </div>
            <div class="info-block">
              <h4>LED-Steuerung</h4>
              <p>Recherche verschiedener Methoden um LEDs über einen ESP32 zu steuern — PWM, digitale Ausgänge, Dimmen und Farbtemperatur.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- P — Planen -->
    <div class="iperka-step iperka-step--active">
      <div class="step-marker">
        <div class="step-dot step-dot--active"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">P</span>
          <div>
            <h3>Planen</h3>
            <span class="step-badge step-badge--active">Aktuell</span>
          </div>
        </div>
        <div class="step-body">
          <p>
            Ich bin aktuell in der Planungsphase. Das Projekt ist eine selbst gebaute Monitor-Lampe,
            die über einen ESP32 gesteuert wird.
          </p>
          <div class="plan-grid">
            <div class="plan-card">
              <h4>Funktion</h4>
              <ul>
                <li>Helligkeit über Schieberegler einstellbar</li>
                <li>Farbtemperatur über zweiten Schieberegler</li>
                <li>Ein/Aus per Widerstandsknopf</li>
                <li>Controller: ESP32</li>
              </ul>
            </div>
            <div class="plan-card">
              <h4>Materialbeschaffung</h4>
              <ul>
                <li class="done">Lampenmaterial — <strong>gekauft</strong></li>
                <li class="pending">ESP32 Controller — <em>ausstehend</em></li>
                <li class="pending">LED-Streifen — <em>ausstehend</em></li>
                <li class="pending">Widerstände & Schieberegler — <em>ausstehend</em></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- E — Entscheiden -->
    <div class="iperka-step iperka-step--upcoming">
      <div class="step-marker">
        <div class="step-dot step-dot--upcoming"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">E</span>
          <div>
            <h3>Entscheiden</h3>
            <span class="step-badge step-badge--upcoming">Ausstehend</span>
          </div>
        </div>
        <div class="step-body step-body--empty">
          <p>Diese Phase wird nach Abschluss der Planung bearbeitet.</p>
        </div>
      </div>
    </div>

    <!-- R — Realisieren -->
    <div class="iperka-step iperka-step--upcoming">
      <div class="step-marker">
        <div class="step-dot step-dot--upcoming"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">R</span>
          <div>
            <h3>Realisieren</h3>
            <span class="step-badge step-badge--upcoming">Ausstehend</span>
          </div>
        </div>
        <div class="step-body step-body--empty">
          <p>Die Umsetzung des Projekts erfolgt nach der Entscheidungsphase.</p>
        </div>
      </div>
    </div>

    <!-- K — Kontrollieren -->
    <div class="iperka-step iperka-step--upcoming">
      <div class="step-marker">
        <div class="step-dot step-dot--upcoming"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">K</span>
          <div>
            <h3>Kontrollieren</h3>
            <span class="step-badge step-badge--upcoming">Ausstehend</span>
          </div>
        </div>
        <div class="step-body step-body--empty">
          <p>Testen und Qualitätssicherung des fertigen Projekts.</p>
        </div>
      </div>
    </div>

    <!-- A — Auswerten -->
    <div class="iperka-step iperka-step--upcoming" style="margin-bottom: 80px;">
      <div class="step-marker">
        <div class="step-dot step-dot--upcoming"></div>
        <div class="step-line step-line--last"></div>
      </div>
      <div class="step-content">
        <div class="step-head">
          <span class="step-letter">A</span>
          <div>
            <h3>Auswerten</h3>
            <span class="step-badge step-badge--upcoming">Ausstehend</span>
          </div>
        </div>
        <div class="step-body step-body--empty">
          <p>Abschliessende Auswertung, Reflexion und Dokumentation.</p>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 56px;
    align-items: start;
    padding: 72px 0 56px;
  }

  .hero h1 { font-size: clamp(28px, 4.5vw, 48px); margin: 6px 0 18px; }
  .hero-desc { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 28px; }
  .hero-desc strong { color: var(--text); }

  .meta { display: flex; flex-direction: column; margin-bottom: 22px; }
  .meta-row { display: flex; align-items: center; gap: 16px; padding: 11px 0; border-bottom: 0.5px solid var(--border); font-size: 14px; }
  .meta-label { font-size: 11px; font-weight: 500; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); min-width: 64px; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }

  /* Hero summary card */
  .hero-summary {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .hero-summary h3 { font-size: 16px; margin: 8px 0 10px; }
  .hero-summary p  { font-size: 13px; color: var(--muted); line-height: 1.65; margin-bottom: 20px; }

  .components { display: flex; flex-direction: column; gap: 8px; }
  .component {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    border: 0.5px solid var(--border);
    background: var(--bg);
  }
  .comp-icon { font-size: 14px; flex-shrink: 0; }
  .component--done .comp-icon { color: #5ab88a; }
  .component--pending .comp-icon { color: var(--muted); }
  .comp-name { font-size: 13px; font-weight: 500; color: var(--text); }
  .comp-status { font-size: 11px; color: var(--muted); margin-top: 1px; }

  /* Section */
  .section { padding: 48px 0 24px; }
  .section h2 { margin: 6px 0 10px; }
  .section-sub { font-size: 15px; color: var(--muted); line-height: 1.7; max-width: 560px; }

  /* IPERKA Steps */
  .iperka-step {
    display: flex;
    gap: 24px;
    margin-bottom: 0;
  }

  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .step-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--bg);
    flex-shrink: 0;
    z-index: 1;
  }
  .step-dot--done   { background: #5ab88a; border-color: #5ab88a; }
  .step-dot--active { background: var(--accent); border-color: var(--accent); }
  .step-dot--upcoming { background: var(--bg); border-color: var(--border); }

  .step-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin: 4px 0;
    min-height: 32px;
  }
  .step-line--last { display: none; }

  .step-content {
    padding-bottom: 40px;
    flex: 1;
    min-width: 0;
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .step-letter {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--text);
    min-width: 28px;
    line-height: 1;
  }
  .iperka-step--upcoming .step-letter { color: var(--muted); opacity: 0.4; }

  .step-head h3 { font-size: 20px; letter-spacing: -0.02em; margin: 0; }
  .iperka-step--upcoming .step-head h3 { color: var(--muted); }

  .step-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }
  .step-badge--done     { background: rgba(90, 184, 138, 0.12); color: #5ab88a; }
  .step-badge--active   { background: var(--tag-bg); color: var(--accent); }
  .step-badge--upcoming { background: var(--surface2); color: var(--muted); }

  .step-body > p {
    font-size: 14px; color: var(--muted); line-height: 1.75;
    margin-bottom: 20px; max-width: 640px;
  }
  .step-body--empty > p { font-style: italic; opacity: 0.6; }

  /* Info blocks (Informieren) */
  .info-blocks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .info-block {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px;
  }
  .info-block h4 { font-size: 13px; font-weight: 700; margin-bottom: 6px; letter-spacing: -0.01em; }
  .info-block p  { font-size: 12px; color: var(--muted); line-height: 1.6; }

  /* Plan grid (Planen) */
  .plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .plan-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px;
  }
  .plan-card h4 { font-size: 13px; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.01em; }
  .plan-card ul { display: flex; flex-direction: column; gap: 7px; }
  .plan-card li {
    font-size: 13px; color: var(--muted);
    padding-left: 14px; position: relative; line-height: 1.5;
  }
  .plan-card li::before { content: '—'; position: absolute; left: 0; color: var(--border-md); font-size: 11px; }
  .plan-card li.done { color: var(--text); }
  .plan-card li.done::before { color: #5ab88a; }
  .plan-card li.pending::before { color: var(--accent); }
  .plan-card li strong { color: #5ab88a; }
  .plan-card li em { color: var(--accent); font-style: normal; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 28px; }
    .info-blocks { grid-template-columns: 1fr; }
    .plan-grid { grid-template-columns: 1fr; }
  }
</style>