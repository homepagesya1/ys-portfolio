---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="YS.Workout" lang="de">
  <div class="container">

    <a href="/de/services" class="back-link">← Zurück zu Services</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <span class="section-label">App</span>
      <h1>YS.Workout.</h1>
      <p class="hero-tagline">Dein Training. Dein Fortschritt.</p>
      <p class="hero-desc">
        Halte jede Übung, jedes Gewicht und jeden Satz direkt auf dem Handy fest —
        und sieh mit der Zeit, wie viel stärker du wirst.
      </p>
      <div class="hero-badges">
        <span class="badge-pill">✅ Jetzt gratis</span>
        <span class="badge-pill">📱 Kein App-Download nötig</span>
        <span class="badge-pill">🔒 Kein Abo erforderlich</span>
      </div>
      <div class="hero-actions">
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary">Kostenlos starten →</a>
        <a href="https://workout.yannicksalm.ch/login" target="_blank" rel="noopener noreferrer" class="btn-outline">Login</a>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== FEATURES ===== -->
    <section class="section">
      <span class="section-label">Features</span>
      <h2>Was die App kann.</h2>

      <div class="features">

        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-label">Trainingsplan</span>
            <h3>Dein Plan, immer griffbereit</h3>
            <p>Erstelle deine eigenen Trainingspläne mit beliebig vielen Übungen. Ob Brust, Rücken oder Beine — du entscheidest, was wann trainiert wird. Alles ist in Sekunden abrufbar, auch mitten im Gym.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📋</div>
          </div>
        </div>

        <div class="feature-row feature-row--reverse">
          <div class="feature-text">
            <span class="feature-label">Live Tracking</span>
            <h3>Jeder Satz zählt</h3>
            <p>Während du trainierst, tippst du einfach ein wie viele Wiederholungen du gemacht hast und mit welchem Gewicht. Das war's. Kein Zettel, kein Vergessen — alles wird automatisch gespeichert.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">⚡</div>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-label">Statistiken</span>
            <h3>Sieh, wie du stärker wirst</h3>
            <p>Nach jedem Training siehst du, ob du mehr geschafft hast als letzte Woche. Neue Bestleistungen werden automatisch erkannt und markiert. Motivation pur — direkt aus deinen eigenen Zahlen.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📈</div>
          </div>
        </div>

        <div class="feature-row feature-row--reverse">
          <div class="feature-text">
            <span class="feature-label">Kein App Store nötig</span>
            <h3>Direkt auf den Homescreen</h3>
            <p>Du musst nichts herunterladen oder installieren. Öffne die App einmal im Browser, füge sie deinem Homescreen hinzu — und schon verhält sie sich wie eine normale App. Funktioniert auf iPhone und Android.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📲</div>
          </div>
        </div>

      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PERSONAL TRAINER ===== -->
    <section class="section">
      <span class="section-label">Für Personal Trainer</span>
      <h2>Beneficial für Personal Trainers.</h2>
      <p class="section-text">
        YS.Workout entwickelt sich weiter — und Personal Trainer stehen dabei im Fokus. Was jetzt
        schon möglich ist und was bald kommt:
      </p>
      <div class="trainer-grid">
        <div class="trainer-card trainer-card--available">
          <span class="trainer-status">✅ Jetzt verfügbar</span>
          <h3>Eigene Pläne erstellen</h3>
          <p>Personal Trainer können bereits heute eigene Trainingspläne direkt in der App erstellen und strukturieren — für jeden Kunden individuell.</p>
        </div>
        <div class="trainer-card trainer-card--soon">
          <span class="trainer-status">🔮 In Entwicklung</span>
          <h3>Pläne teilen mit Kunden</h3>
          <p>In Zukunft wird es möglich sein, erstellte Trainingspläne direkt über die App mit Kunden zu teilen. Der Trainer erstellt — der Kunde trainiert. Ohne Umwege, ohne externe Tools.</p>
        </div>
        <div class="trainer-card trainer-card--soon">
          <span class="trainer-status">🔮 Geplant</span>
          <h3>Fortschritt der Kunden verfolgen</h3>
          <p>Trainer sollen künftig den Fortschritt ihrer Kunden einsehen können — Gewichte, Sätze, Bestleistungen. Alles auf einen Blick.</p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== BETA ===== -->
    <section class="section">
      <span class="section-label">Beta Phase</span>
      <h2>Die App ist in der Beta.</h2>
      <p class="section-text">
        YS.Workout befindet sich aktuell in der Testphase. Das heisst: Du kannst alles gratis
        nutzen — und du hilfst aktiv mit, die App besser zu machen.
      </p>
      <div class="beta-grid">
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="beta-card beta-card--link">
          <div class="beta-icon">🐛</div>
          <h3>Bug reporten</h3>
          <p>Ist etwas kaputt oder verhält sich komisch? Meld dich direkt — jeder Bug-Report hilft.</p>
          <span class="beta-cta">Bug melden →</span>
        </a>
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="beta-card beta-card--link">
          <div class="beta-icon">💡</div>
          <h3>Feature vorschlagen</h3>
          <p>Du vermisst etwas? Schlag es vor. Die besten Feature-Ideen kommen von Leuten, die die App wirklich nutzen.</p>
          <span class="beta-cta">Idee einreichen →</span>
        </a>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PRICING ===== -->
    <section class="section">
      <span class="section-label">Preise</span>
      <h2>Jetzt gratis. Immer fair.</h2>
      <div class="pricing-cards">

        <div class="pricing-card pricing-card--active">
          <div class="pricing-emoji">🎉</div>
          <h3>Jetzt: Gratis</h3>
          <p>Die App ist aktuell komplett kostenlos nutzbar. Keine Kreditkarte, kein Abo, kein Haken. Einfach registrieren und loslegen.</p>
          <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary" style="margin-top: auto;">Jetzt kostenlos starten</a>
        </div>

        <div class="pricing-card">
          <div class="pricing-emoji">❤️</div>
          <h3>Unterstützen</h3>
          <p>Die App kostet Geld zu betreiben und weiterzuentwickeln. Wer möchte, kann freiwillig etwas beitragen — jeder Betrag hilft, neue Features zu bauen.</p>
          <a href="https://workout.yannicksalm.ch/spenden" target="_blank" rel="noopener noreferrer" class="btn-outline" style="margin-top: auto;">Spenden (freiwillig) →</a>
        </div>

        <div class="pricing-card pricing-card--muted">
          <div class="pricing-emoji">🔮</div>
          <h3>Bald: Abo</h3>
          <p>In Zukunft wird YS.Workout ein kleines monatliches Abo erfordern. Geplant ist unter 1 CHF / 1 Euro pro Monat. Wer früh dabei ist, profitiert von den besten Konditionen.</p>
          <span class="not-available">Noch nicht verfügbar</span>
        </div>

      </div>
    </section>

    <!-- ===== CTA ===== -->
    <div class="cta-card">
      <div>
        <h2>Bereit, dein Training ernstzunehmen?</h2>
        <p>Registriere dich jetzt gratis — keine Kreditkarte, kein Abo, kein Risiko.</p>
      </div>
      <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary">Kostenlos starten →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .hero { padding: 72px 0 56px; max-width: 680px; }
  .hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 6px 0 6px; }
  .hero-tagline { font-family: var(--font-display); font-size: 20px; color: var(--accent); margin-bottom: 16px; font-weight: 700; letter-spacing: -0.02em; }
  .hero-desc { font-size: 16px; color: var(--muted); line-height: 1.75; margin-bottom: 20px; }

  .hero-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .badge-pill {
    display: inline-block;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 13px;
    color: var(--text);
    padding: 6px 14px;
  }

  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .section { padding: 56px 0; }
  .section h2 { margin: 6px 0 16px; }
  .section-text { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 28px; max-width: 640px; }

  /* Features */
  .features { display: flex; flex-direction: column; gap: 0; margin-top: 20px; }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 40px;
    align-items: center;
    padding: 40px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .feature-row:last-child { border-bottom: none; }
  .feature-row--reverse { direction: rtl; }
  .feature-row--reverse > * { direction: ltr; }

  .feature-label {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .feature-text h3 { font-size: 20px; letter-spacing: -0.02em; margin-bottom: 10px; }
  .feature-text p  { font-size: 14px; color: var(--muted); line-height: 1.7; max-width: 480px; }

  .feature-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    aspect-ratio: 1;
    max-width: 160px;
    justify-self: center;
  }
  .feature-icon-big { font-size: 48px; }

  /* Trainer */
  .trainer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .trainer-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px;
  }
  .trainer-card--soon { opacity: 0.7; }
  .trainer-status { display: block; font-size: 11px; font-weight: 500; color: var(--muted); margin-bottom: 10px; }
  .trainer-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
  .trainer-card p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* Beta */
  .beta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .beta-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color var(--trans), transform var(--trans);
  }
  .beta-card:hover { border-color: var(--border-md); transform: translateY(-2px); }
  .beta-icon { font-size: 28px; margin-bottom: 4px; }
  .beta-card h3 { font-size: 15px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  .beta-card p  { font-size: 13px; color: var(--muted); line-height: 1.6; flex: 1; }
  .beta-cta { font-size: 13px; color: var(--accent); font-weight: 500; margin-top: 4px; }

  /* Pricing */
  .pricing-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .pricing-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pricing-card--active { border-color: var(--accent); }
  .pricing-card--muted { opacity: 0.65; }
  .pricing-emoji { font-size: 28px; }
  .pricing-card h3 { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  .pricing-card p  { font-size: 13px; color: var(--muted); line-height: 1.65; flex: 1; }
  .not-available {
    display: inline-block;
    font-size: 12px;
    color: var(--muted);
    background: var(--surface2);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    margin-top: auto;
    align-self: flex-start;
  }

  /* CTA */
  .cta-card {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); padding: 28px 32px;
    margin: 48px 0 80px;
  }
  .cta-card h2 { font-size: 22px; margin-bottom: 6px; }
  .cta-card p  { font-size: 14px; color: var(--muted); }

  @media (max-width: 860px) {
    .trainer-grid { grid-template-columns: 1fr; }
    .pricing-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .feature-row { grid-template-columns: 1fr; }
    .feature-row--reverse { direction: ltr; }
    .feature-visual { display: none; }
    .beta-grid { grid-template-columns: 1fr; }
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
</style>