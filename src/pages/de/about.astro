---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Über mich" lang="de">
  <div class="container">

    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="hero-text">
        <span class="section-label">Über mich</span>
        <h1>Hey, ich bin<br />Yannick<span class="dot">.</span></h1>
        <p>
          Ich bin angehender Informatiker mit grossem Interesse an Webentwicklung,
          UI/UX-Design und Infrastruktur. Ich entwickle moderne Weblösungen und
          arbeite gerne an Projekten an der Schnittstelle zwischen Design und Technik.
        </p>
        <p>
          Ebenfalls ist Sport ein wichtiger Teil meines Lebens — Halbmarathon-Training,
          Gym, Badminton und Biken. Dadurch fühle ich mich wesentlich besser und
          kann produktiver durch den Tag gehen.
        </p>
        <p>
          Meine Schwäche: definitiv der Schlaf. Ich arbeite sehr gerne bis in die
          Nacht. Meine Stärke: Wenn ich ein Projekt habe, das mir Spass macht,
          ziehe ich durch, bis es mir oder dem Auftraggeber gefällt.
        </p>
        <div class="hero-actions">
          <a href="/de/projects" class="btn-primary">Projekte ansehen</a>
          <a href="/de/contact" class="btn-outline">Kontakt</a>
        </div>
      </div>

      <div class="hero-portrait">
        <img src="/images/Me.JPG" alt="Portrait von Yannick Salm" />
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== SKILLS ===== -->
    <section class="section">
      <span class="section-label">Skills</span>
      <div class="skills-grid">

        <div class="skill-card">
          <div class="skill-icon">⬡</div>
          <h3>Frontend</h3>
          <div class="skill-list">
            <span class="chip">HTML</span>
            <span class="chip">CSS</span>
            <span class="chip">JavaScript</span>
            <span class="chip">Astro</span>
          </div>
        </div>

        <div class="skill-card">
          <div class="skill-icon">⬡</div>
          <h3>Backend</h3>
          <div class="skill-list">
            <span class="chip">Node.js</span>
            <span class="chip">APIs</span>
            <span class="chip">JSON</span>
          </div>
        </div>

        <div class="skill-card">
          <div class="skill-icon">⬡</div>
          <h3>Infrastruktur</h3>
          <div class="skill-list">
            <span class="chip">Proxmox</span>
            <span class="chip">Linux</span>
            <span class="chip">Cloudflare</span>
            <span class="chip">Infomaniak</span>
          </div>
        </div>

        <div class="skill-card">
          <div class="skill-icon">⬡</div>
          <h3>Tools</h3>
          <div class="skill-list">
            <span class="chip">Git</span>
            <span class="chip">GitHub</span>
            <span class="chip">VS Code</span>
            <span class="chip">Microsoft 365</span>
          </div>
        </div>

      </div>
    </section>

    <hr class="divider" />

    <!-- ===== TIMELINE ===== -->
    <section class="section">
      <span class="section-label">Werdegang</span>
      <div class="timeline">

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Frühling 2021</span>
            <h3>Erste Zeile Code</h3>
            <p>Erster Kontakt mit Python — der Anfang von allem.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Winter 2022</span>
            <h3>Zusage Lehrstelle</h3>
            <p>Zusage für die Lehrstelle als Informatiker Plattformentwicklung bei der SVA Aargau.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Sommer 2023</span>
            <h3>Lehrbeginn bei SVA Aargau</h3>
            <p>Start der Lehre als Informatiker EFZ, Fachrichtung Plattformentwicklung.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">2024 – 2025</span>
            <h3>Erste eigene Projekte</h3>
            <p>Herumprobieren mit WordPress, erste eigene Webseiten und Apps.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Sommer 2025</span>
            <h3>This or That — Quiz Webseite</h3>
            <p>Entwicklung einer Zwei-Spieler Quiz-Webseite mit Login und API.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Sommer 2025</span>
            <h3>Cambridge English First Certificate</h3>
            <p>Sprachzertifikat B2 erfolgreich abgeschlossen.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Herbst 2025</span>
            <h3>Launch Frauenverein Sarmenstorf</h3>
            <p>Aufbau und Release der komplett neu entwickelten Vereinswebseite.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">Ende 2025</span>
            <h3>Weiterentwicklung Frauenverein Webseite</h3>
            <p>Laufender Support und Weiterentwicklung nach dem Launch.</p>
          </div>
        </div>

        <div class="tl-item tl-item--current">
          <div class="tl-dot"></div>
          <div class="tl-content">
            <span class="tl-year">2026 — Aktuell</span>
            <h3>Bereit für neue Projekte</h3>
            <p>Bauen, lernen, liefern.</p>
          </div>
        </div>

      </div>
    </section>

    <hr class="divider" />

    <!-- ===== INTERESSEN ===== -->
    <section class="section">
      <span class="section-label">Interessen</span>
      <div class="interest-grid">
        <div class="interest-card">
          <span class="interest-icon">🏃</span>
          <div>
            <strong>Laufen</strong>
            <p>Halbmarathon-Training</p>
          </div>
        </div>
        <div class="interest-card">
          <span class="interest-icon">💪</span>
          <div>
            <strong>Gym</strong>
            <p>Kraft & Fitness</p>
          </div>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🏸</span>
          <div>
            <strong>Badminton</strong>
            <p>Wettkampf & Freizeit</p>
          </div>
        </div>
        <div class="interest-card">
          <span class="interest-icon">🚵</span>
          <div>
            <strong>Biken</strong>
            <p>Trail & Bergbike</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== CTA ===== -->
    <section class="cta-section">
      <div class="cta-card">
        <div>
          <h2>Interesse an einer Zusammenarbeit?</h2>
          <p>Wenn dies dein Interesse geweckt hat, melde dich gerne.</p>
        </div>
        <a href="/de/contact" class="btn-primary">Kontakt aufnehmen</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
    align-items: stretch;
    padding: 72px 0 64px;
  }

  .hero-text h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 6px 0 24px;
    line-height: 1.08;
  }
  .hero-text h1 .dot { color: var(--accent); }

  .hero-text p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 14px;
    max-width: 100%;
  }

  .hero-actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }

  .hero-portrait {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 0.5px solid var(--border);
    height: 100%;
    min-height: 480px;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Sections */
  .section { padding: 56px 0; }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 20px;
  }

  .skill-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .skill-icon {
    font-size: 18px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .skill-card h3 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
    color: var(--text);
  }

  .skill-list { display: flex; flex-wrap: wrap; gap: 6px; }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
    position: relative;
  }

  /* Vertical line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border);
  }

  .tl-item {
    display: flex;
    gap: 20px;
    padding-bottom: 32px;
    position: relative;
  }
  .tl-item:last-child { padding-bottom: 0; }

  .tl-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--bg);
    flex-shrink: 0;
    margin-top: 3px;
    position: relative;
    z-index: 1;
  }

  .tl-item--current .tl-dot {
    border-color: var(--accent);
    background: var(--accent);
  }

  .tl-year {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .tl-content h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .tl-content p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* Interests */
  .interest-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 20px;
  }

  .interest-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .interest-icon { font-size: 22px; flex-shrink: 0; }

  .interest-card strong {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 2px;
  }
  .interest-card p { font-size: 12px; color: var(--muted); }

  /* CTA */
  .cta-section { padding: 56px 0 24px; }
  .cta-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 32px;
  }
  .cta-card h2 { font-size: 22px; margin-bottom: 6px; }
  .cta-card p  { font-size: 14px; color: var(--muted); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 36px; }
    .hero-portrait { max-width: 260px; aspect-ratio: 1; }
    .skills-grid { grid-template-columns: 1fr 1fr; }
    .interest-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .skills-grid { grid-template-columns: 1fr; }
    .interest-grid { grid-template-columns: 1fr; }
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
</style>