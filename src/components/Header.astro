---
type Lang = 'en' | 'de'

interface Props {
  lang: Lang
  currentPath: string
}

const { lang, currentPath } = Astro.props

const otherLang = lang === 'en' ? 'de' : 'en'

const otherLangPath = currentPath.startsWith(`/${lang}/`)
  ? currentPath.replace(`/${lang}/`, `/${otherLang}/`)
  : `/${otherLang}`

const nav = lang === 'en'
  ? { home: 'Home', about: 'About', projects: 'Projects', services: 'Services', contact: 'Contact' }
  : { home: 'Home', about: 'Über mich', projects: 'Projekte', services: 'Services', contact: 'Kontakt' }

const navItems = [
  { href: `/${lang}`,          label: nav.home },
  { href: `/${lang}/about`,    label: nav.about },
  { href: `/${lang}/projects`, label: nav.projects },
  { href: `/${lang}/services`, label: nav.services },
  { href: `/${lang}/contact`,  label: nav.contact },
]

function isActive(href: string): boolean {
  if (href === `/${lang}`) return currentPath === href || currentPath === `/${lang}/`
  return currentPath.startsWith(href)
}
---

<header class="site-header">
  <div class="header-inner container">

    <a class="brand" href={`/${lang}`}>YS<span>.</span></a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="controls">
      <a href={otherLangPath} class="ctrl-btn" aria-label="Switch language">
        {otherLang.toUpperCase()}
      </a>

      <button class="ctrl-btn theme-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
        <span class="icon-moon">☾</span>
        <span class="icon-sun">☀</span>
      </button>

      <button
        class="hamburger"
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label="Mobile navigation">
    <ul class="container">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 0.5px solid var(--border);
    transition: background 0.3s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--text);
    flex-shrink: 0;
  }
  .brand span { color: var(--accent); }

  .desktop-nav ul { display: flex; align-items: center; gap: 2px; }
  .desktop-nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    transition: color var(--trans), background var(--trans);
  }
  .desktop-nav a:hover { color: var(--text); }
  .desktop-nav a.active { color: var(--text); background: var(--surface2); }

  .controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 36px;
    padding: 0 12px;
    background: var(--surface2);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-decoration: none;
    transition: color var(--trans), border-color var(--trans);
  }
  .ctrl-btn:hover { color: var(--text); border-color: var(--border-md); }

  /*
    THE FIX: [data-theme] sitzt auf <html> — ausserhalb des Astro-Scope.
    Ohne :global() erreicht der scoped Style das Root-Element nicht.
  */
  .icon-moon { display: inline; }
  .icon-sun  { display: none; }
  :global([data-theme="light"]) .icon-moon { display: none; }
  :global([data-theme="light"]) .icon-sun  { display: inline; }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: var(--surface2);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 8px;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--muted);
    border-radius: 2px;
    transition: all var(--trans);
  }

  .mobile-nav {
    background: var(--bg);
    border-top: 0.5px solid var(--border);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .mobile-nav.is-open { max-height: 400px; }
  .mobile-nav ul { display: flex; flex-direction: column; padding: 8px 0 20px; }
  .mobile-nav a {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    padding: 11px 0;
    border-bottom: 0.5px solid var(--border);
    transition: color var(--trans);
  }
  .mobile-nav a.active,
  .mobile-nav a:hover { color: var(--text); }

  @media (max-width: 700px) {
    .desktop-nav { display: none; }
    .hamburger   { display: flex; }
  }
</style>

<script>
  const root = document.documentElement

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
    root.setAttribute('data-theme', next)
    localStorage.setItem('ys-theme', next)
  })

  const menuToggle = document.getElementById('menu-toggle')
  const mobileNav  = document.getElementById('mobile-nav')

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true'
    menuToggle.setAttribute('aria-expanded', String(!isOpen))
    if (!isOpen) {
      mobileNav!.hidden = false
      requestAnimationFrame(() => mobileNav!.classList.add('is-open'))
    } else {
      mobileNav!.classList.remove('is-open')
      mobileNav!.addEventListener('transitionend', () => { mobileNav!.hidden = true }, { once: true })
    }
  })
</script>