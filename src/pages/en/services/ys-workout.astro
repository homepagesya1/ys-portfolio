---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="YS.Workout" lang="en">
  <div class="container">

    <a href="/en/services" class="back-link">← Back to Services</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <span class="section-label">App</span>
      <h1>YS.Workout.</h1>
      <p class="hero-tagline">Your training. Your progress.</p>
      <p class="hero-desc">
        Track every exercise, every weight and every set directly on your phone —
        and watch yourself get stronger over time.
      </p>
      <div class="hero-badges">
        <span class="badge-pill">✅ Free right now</span>
        <span class="badge-pill">📱 No app download needed</span>
        <span class="badge-pill">🔒 No subscription required</span>
      </div>
      <div class="hero-actions">
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary">Start for free →</a>
        <a href="https://workout.yannicksalm.ch/login" target="_blank" rel="noopener noreferrer" class="btn-outline">Login</a>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== FEATURES ===== -->
    <section class="section">
      <span class="section-label">Features</span>
      <h2>What the app can do.</h2>

      <div class="features">

        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-label">Training plan</span>
            <h3>Your plan, always at hand</h3>
            <p>Create your own training plans with as many exercises as you want. Whether chest, back or legs — you decide what gets trained when. Everything is accessible in seconds, even in the middle of the gym.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📋</div>
          </div>
        </div>

        <div class="feature-row feature-row--reverse">
          <div class="feature-text">
            <span class="feature-label">Live tracking</span>
            <h3>Every set counts</h3>
            <p>While you train, you simply enter how many reps you did and with what weight. That's it. No paper, no forgetting — everything is saved automatically.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">⚡</div>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-text">
            <span class="feature-label">Statistics</span>
            <h3>Watch yourself get stronger</h3>
            <p>After each workout you can see whether you did more than last week. New personal bests are automatically detected and highlighted. Pure motivation — straight from your own numbers.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📈</div>
          </div>
        </div>

        <div class="feature-row feature-row--reverse">
          <div class="feature-text">
            <span class="feature-label">No app store needed</span>
            <h3>Straight to your homescreen</h3>
            <p>Nothing to download or install. Open the app once in your browser, add it to your homescreen — and it behaves just like a native app. Works on iPhone and Android.</p>
          </div>
          <div class="feature-visual">
            <div class="feature-icon-big">📲</div>
          </div>
        </div>

      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PERSONAL TRAINER ===== -->
    <section class="section">
      <span class="section-label">For personal trainers</span>
      <h2>Beneficial for personal trainers.</h2>
      <p class="section-text">
        YS.Workout keeps growing — and personal trainers are a key focus. Here's what's
        already possible and what's coming soon:
      </p>
      <div class="trainer-grid">
        <div class="trainer-card trainer-card--available">
          <span class="trainer-status">✅ Available now</span>
          <h3>Create your own plans</h3>
          <p>Personal trainers can already create and structure their own training plans directly in the app — individually tailored for each client.</p>
        </div>
        <div class="trainer-card trainer-card--soon">
          <span class="trainer-status">🔮 In development</span>
          <h3>Share plans with clients</h3>
          <p>Soon it will be possible to share training plans directly with clients through the app. Trainer creates — client trains. No detours, no external tools.</p>
        </div>
        <div class="trainer-card trainer-card--soon">
          <span class="trainer-status">🔮 Planned</span>
          <h3>Track client progress</h3>
          <p>Trainers will be able to view their clients' progress — weights, sets, personal bests. Everything at a glance.</p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== BETA ===== -->
    <section class="section">
      <span class="section-label">Beta phase</span>
      <h2>The app is in beta.</h2>
      <p class="section-text">
        YS.Workout is currently in its testing phase. That means: you can use everything
        for free — and help make the app better along the way.
      </p>
      <div class="beta-grid">
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="beta-card">
          <div class="beta-icon">🐛</div>
          <h3>Report a bug</h3>
          <p>Something broken or behaving strangely? Get in touch directly — every bug report helps.</p>
          <span class="beta-cta">Report a bug →</span>
        </a>
        <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="beta-card">
          <div class="beta-icon">💡</div>
          <h3>Suggest a feature</h3>
          <p>Missing something? Suggest it. The best feature ideas come from people who actually use the app.</p>
          <span class="beta-cta">Submit an idea →</span>
        </a>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PRICING ===== -->
    <section class="section">
      <span class="section-label">Pricing</span>
      <h2>Free now. Always Fair.</h2>
      <div class="pricing-cards">

        <div class="pricing-card pricing-card--active">
          <div class="pricing-emoji">🎉</div>
          <h3>Now: Free</h3>
          <p>The app is completely free to use right now. No credit card, no subscription, no catch. Just sign up and get started.</p>
          <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary" style="margin-top: auto;">Start for free</a>
        </div>

        <div class="pricing-card">
          <div class="pricing-emoji">❤️</div>
          <h3>Support</h3>
          <p>Running and developing the app costs money. Anyone who wants to can contribute voluntarily — every amount helps build new features and eventually launch real iOS & Android apps.</p>
          <a href="https://workout.yannicksalm.ch/spenden" target="_blank" rel="noopener noreferrer" class="btn-outline" style="margin-top: auto;">Donate (optional) →</a>
        </div>

        <div class="pricing-card pricing-card--muted">
          <div class="pricing-emoji">🔮</div>
          <h3>Coming soon: Subscription</h3>
          <p>In the future, YS.Workout will require a small monthly subscription. The plan is under CHF 1 / €1 per month. Early users get the best conditions.</p>
          <span class="not-available">Not yet available</span>
        </div>

      </div>
    </section>

    <!-- ===== CTA ===== -->
    <div class="cta-card">
      <div>
        <h2>Ready to take your training seriously?</h2>
        <p>Sign up for free now — no credit card, no subscription, no risk.</p>
      </div>
      <a href="https://workout.yannicksalm.ch/register" target="_blank" rel="noopener noreferrer" class="btn-primary">Start for free →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .hero { padding: 72px 0 56px; max-width: 680px; }
  .hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 6px 0 6px; }
  .hero-tagline { font-family: var(--font-display); font-size: 20px; color: var(--accent); margin-bottom: 16px; font-weight: 700; letter-spacing: -0.02em; }
  .hero-desc { font-size: 16px; color: var(--muted); line-height: 1.75; margin-bottom: 20px; }

  .hero-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .badge-pill {
    display: inline-block;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 13px;
    color: var(--text);
    padding: 6px 14px;
  }

  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .section { padding: 56px 0; }
  .section h2 { margin: 6px 0 16px; }
  .section-text { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 28px; max-width: 640px; }

  .features { display: flex; flex-direction: column; margin-top: 20px; }
  .feature-row {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 40px;
    align-items: center;
    padding: 40px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .feature-row:last-child { border-bottom: none; }
  .feature-row--reverse { direction: rtl; }
  .feature-row--reverse > * { direction: ltr; }

  .feature-label { display: block; font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .feature-text h3 { font-size: 20px; letter-spacing: -0.02em; margin-bottom: 10px; }
  .feature-text p  { font-size: 14px; color: var(--muted); line-height: 1.7; max-width: 480px; }

  .feature-visual {
    display: flex; align-items: center; justify-content: center;
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); aspect-ratio: 1;
    max-width: 160px; justify-self: center;
  }
  .feature-icon-big { font-size: 48px; }

  .trainer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .trainer-card { background: var(--surface); border: 0.5px solid var(--border); border-radius: var(--radius-md); padding: 22px; }
  .trainer-card--soon { opacity: 0.7; }
  .trainer-status { display: block; font-size: 11px; font-weight: 500; color: var(--muted); margin-bottom: 10px; }
  .trainer-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
  .trainer-card p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  .beta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .beta-card {
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); padding: 24px;
    text-decoration: none; display: flex; flex-direction: column; gap: 8px;
    transition: border-color var(--trans), transform var(--trans);
  }
  .beta-card:hover { border-color: var(--border-md); transform: translateY(-2px); }
  .beta-icon { font-size: 28px; margin-bottom: 4px; }
  .beta-card h3 { font-size: 15px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  .beta-card p  { font-size: 13px; color: var(--muted); line-height: 1.6; flex: 1; }
  .beta-cta { font-size: 13px; color: var(--accent); font-weight: 500; margin-top: 4px; }

  .pricing-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .pricing-card {
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); padding: 24px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .pricing-card--active { border-color: var(--accent); }
  .pricing-card--muted { opacity: 0.65; }
  .pricing-emoji { font-size: 28px; }
  .pricing-card h3 { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  .pricing-card p  { font-size: 13px; color: var(--muted); line-height: 1.65; flex: 1; }
  .not-available {
    display: inline-block; font-size: 12px; color: var(--muted);
    background: var(--surface2); border: 0.5px solid var(--border);
    border-radius: var(--radius-pill); padding: 5px 12px;
    margin-top: auto; align-self: flex-start;
  }

  .cta-card {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); padding: 28px 32px;
    margin: 48px 0 80px;
  }
  .cta-card h2 { font-size: 22px; margin-bottom: 6px; }
  .cta-card p  { font-size: 14px; color: var(--muted); }

  @media (max-width: 860px) {
    .trainer-grid { grid-template-columns: 1fr; }
    .pricing-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .feature-row { grid-template-columns: 1fr; }
    .feature-row--reverse { direction: ltr; }
    .feature-visual { display: none; }
    .beta-grid { grid-template-columns: 1fr; }
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
</style>