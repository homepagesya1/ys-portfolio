---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Frauenverein Sarmenstorf" lang="de">
    <div class="container">
        <a href="/de/projects" class="back-link">← Zurück zu Projekte</a>

        <!-- ===== HERO ===== -->
        <section class="hero">
            <div class="hero-text">
                <span class="section-label">Projekt</span>
                <h1>Frauenverein Sarmenstorf</h1>
                <p class="hero-desc">
                    Für den Frauenverein Sarmenstorf durfte ich die bestehende
                    Website neu denken und modern umsetzen. Ziel war eine
                    übersichtliche, freundliche und zeitgemässe Webpräsenz, die
                    sowohl optisch überzeugt als auch im Alltag einfach gepflegt
                    werden kann.
                </p>

                <div class="meta">
                    <div class="meta-row">
                        <span class="meta-label">Bereich</span>
                        <span>Webdesign / Webentwicklung</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Rolle</span>
                        <span>Konzept, Design, Umsetzung</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Status</span>
                        <span class="badge badge-live">● Live</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Link</span>
                        <a
                            href="https://frauenverein-sarmenstorf.ch"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="meta-link"
                        >
                            frauenverein-sarmenstorf.ch ↗
                        </a>
                    </div>
                </div>

                <div class="tags">
                    <span class="chip">HTML / CSS</span>
                    <span class="chip">UI / UX</span>
                    <span class="chip">Astro</span>
                </div>
            </div>

            <div class="hero-img">
                <img
                    src="/images/website-frauenverein-sarmenstorf.png"
                    alt="Frauenverein Sarmenstorf Website"
                />
            </div>
        </section>

        <hr class="divider" />

        <!-- ===== AUSGANGSLAGE ===== -->
        <section class="section">
            <span class="section-label">Über das Projekt</span>
            <div class="two-col">
                <div class="info-card">
                    <h3>Ausgangslage</h3>
                    <p>
                        Die bisherige Website wirkte nicht mehr zeitgemäss und
                        war in Struktur, Gestaltung und Benutzerführung
                        ausbaufähig. Inhalte sollten klarer dargestellt und die
                        Seite insgesamt moderner und einladender erscheinen.
                    </p>
                </div>
                <div class="info-card">
                    <h3>Ziel</h3>
                    <p>
                        Die neue Website soll übersichtlich, leicht verständlich
                        und optisch ansprechend sein. Wichtig: Inhalte für
                        Besucherinnen und Besucher schnell auffindbar, und die
                        Seite auf allen mobilen Geräten problemlos nutzbar.
                    </p>
                </div>
            </div>
        </section>

        <hr class="divider" />

        <!-- ===== UMSETZUNG ===== -->
        <section class="section">
            <span class="section-label">Umsetzung</span>
            <h2>Was ich gemacht habe.</h2>
            <div class="features">
                <div class="feature">
                    <span class="feature-num">01</span>
                    <div>
                        <h3>Neues Design</h3>
                        <p>
                            Ein moderneres und ruhigeres Erscheinungsbild, das
                            besser zur Organisation passt und Inhalte klarer
                            präsentiert.
                        </p>
                    </div>
                </div>
                <div class="feature">
                    <span class="feature-num">02</span>
                    <div>
                        <h3>Struktur überarbeitet</h3>
                        <p>
                            Navigation und Seitenstruktur wurden neu gedacht,
                            damit wichtige Informationen schneller gefunden
                            werden können.
                        </p>
                    </div>
                </div>
                <div class="feature">
                    <span class="feature-num">03</span>
                    <div>
                        <h3>Technische Umsetzung</h3>
                        <p>
                            Sauber neu aufgebaut mit Astro — langfristig
                            wartbar, vollständig responsiv und einfach
                            erweiterbar.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <hr class="divider" />

        <!-- ===== BEFORE & AFTER ===== -->
        <section class="section">
            <span class="section-label">Before & After</span>
            <h2>Vergleich vor und nach der Überarbeitung.</h2>
            <div class="ba-grid">
                <a
                    href="https://web.archive.org/web/20240615073649/https://www.frauenverein-sarmenstorf.ch/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ba-card"
                >
                    <div class="ba-header">
                        <h3>Before</h3>
                        <p>
                            Die frühere Version war funktional, aber optisch
                            zurückhaltend und in der Struktur weniger modern.
                        </p>
                    </div>
                    <div class="ba-img">
                        <img
                            src="/images/website-frauenverein-sarmenstorf_old.png"
                            alt="Alte Website Frauenverein Sarmenstorf"
                            loading="lazy"
                        />
                    </div>
                    <span class="ba-link">Wayback Machine ↗</span>
                </a>

                <a
                    href="https://frauenverein-sarmenstorf.ch"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ba-card ba-card--featured"
                >
                    <div class="ba-header">
                        <h3>After</h3>
                        <p>
                            Die neue Version ist klarer aufgebaut, moderner
                            gestaltet und deutlich ansprechender in der Wirkung.
                        </p>
                    </div>
                    <div class="ba-img">
                        <img
                            src="/images/website-frauenverein-sarmenstorf_new.png"
                            alt="Neue Website Frauenverein Sarmenstorf"
                            loading="lazy"
                        />
                    </div>
                    <span class="ba-link">Live Website ↗</span>
                </a>
            </div>
        </section>

        <hr class="divider" />

        <!-- ===== ERGEBNIS ===== -->
        <section class="section">
            <span class="section-label">Ergebnis</span>
            <h2>Mehrwert des Projekts.</h2>
            <div class="result-box">
                <p>
                    Das Resultat ist eine deutlich modernere Website mit
                    verbesserter Benutzerführung, einer klareren Struktur und
                    einem professionelleren Auftritt. Dadurch wirkt der
                    Frauenverein online präsenter und Informationen sind
                    einfacher zugänglich. Das Projekt hat mir gezeigt, wie ein
                    vollständiger Prozess vom ersten Gespräch bis zum Live-Gang
                    für einen echten Kunden aussieht.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .hero {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 56px;
        align-items: start;
        padding: 72px 0 56px;
    }
    .hero-text h1 {
        font-size: clamp(30px, 5vw, 50px);
        margin: 6px 0 18px;
    }
    .hero-desc {
        font-size: 15px;
        color: var(--muted);
        line-height: 1.75;
        margin-bottom: 28px;
    }

    .meta {
        display: flex;
        flex-direction: column;
        margin-bottom: 22px;
    }
    .meta-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 11px 0;
        border-bottom: 0.5px solid var(--border);
        font-size: 14px;
    }
    .meta-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        min-width: 64px;
    }
    .meta-link {
        color: var(--accent);
        font-size: 13px;
        transition: opacity var(--trans);
    }
    .meta-link:hover {
        opacity: 0.75;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .hero-img {
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 0.5px solid var(--border);
        width: 375px;
        height: 500px;
        flex-shrink: 0;
        align-self: flex-start;
    }
    .hero-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
    }

    .section {
        padding: 56px 0;
    }
    .section h2 {
        margin: 6px 0 24px;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .info-card {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        padding: 24px;
    }
    .info-card h3 {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
        letter-spacing: -0.01em;
    }
    .info-card p {
        font-size: 14px;
        color: var(--muted);
        line-height: 1.7;
    }

    .features {
        display: flex;
        flex-direction: column;
    }
    .feature {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        padding: 20px 0;
        border-bottom: 0.5px solid var(--border);
    }
    .feature:last-child {
        border-bottom: none;
    }
    .feature-num {
        font-family: var(--font-display);
        font-size: 13px;
        font-weight: 700;
        color: var(--accent);
        min-width: 28px;
        margin-top: 2px;
    }
    .feature h3 {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 5px;
        letter-spacing: -0.01em;
    }
    .feature p {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.65;
    }

    /* Before/After */
    .ba-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .ba-card {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        text-decoration: none;
        transition:
            border-color var(--trans),
            transform var(--trans);
    }
    .ba-card:hover {
        border-color: var(--border-md);
        transform: translateY(-2px);
    }
    .ba-card--featured {
        border-color: rgba(201, 168, 124, 0.3);
    }

    .ba-header {
        padding: 20px 20px 14px;
    }
    .ba-header h3 {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .ba-header p {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.6;
    }

    .ba-img {
        overflow: hidden;
    }
    .ba-img img {
        width: 100%;
        display: block;
        transition: transform 0.4s ease;
    }
    .ba-card:hover .ba-img img {
        transform: scale(1.02);
    }

    .ba-link {
        display: block;
        font-size: 12px;
        color: var(--accent);
        padding: 12px 20px;
        font-weight: 500;
    }

    /* Result */
    .result-box {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        padding: 28px 32px;
        max-width: 720px;
        margin-bottom: 40px;
    }
    .result-box p {
        font-size: 15px;
        color: var(--muted);
        line-height: 1.75;
    }

    @media (max-width: 860px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 32px;
        }
        .hero-img {
            order: -1;
        }
        .two-col {
            grid-template-columns: 1fr;
        }
        .ba-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
