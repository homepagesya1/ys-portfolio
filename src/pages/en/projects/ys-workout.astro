---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="YS.Workout" lang="en">
  <div class="container">
    <a href="/en/projects" class="back-link">← Back to Projects</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="hero-text">
        <span class="section-label">Project</span>
        <h1>YS.Workout</h1>
        <p class="hero-desc">
          YS.Workout is a modern workout tracking web app — built because no
          existing app fit the way I train. The focus: clean structure,
          intuitive use and a solution that's completely under my control.
        </p>

        <div class="meta">
          <div class="meta-row">
            <span class="meta-label">Area</span>
            <span>Web Design / Development</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Role</span>
            <span>Concept, Design, Development</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Status</span>
            <span class="badge badge-live">● Live</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Link</span>
            <a
              href="https://workout.yannicksalm.ch"
              target="_blank"
              rel="noopener noreferrer"
              class="meta-link"
            >
              workout.yannicksalm.ch ↗
            </a>
          </div>
        </div>

        <div class="tags">
          <span class="chip">HTML / CSS</span>
          <span class="chip">JavaScript</span>
          <span class="chip">UI / UX</span>
          <span class="chip">Astro</span>
        </div>
      </div>

      <div class="hero-img">
        <img src="/images/ys-workout_4.webp" alt="YS.Workout preview" />
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== DESCRIPTION ===== -->
    <section class="section">
      <span class="section-label">About the project</span>
      <div class="two-col">
        <div>
          <h2>What is YS.Workout?</h2>
          <p>
            YS.Workout is a complete workout tracking web app — no app store
            download needed, runs directly in the browser and can be added to
            the homescreen. Every exercise, every weight, every set is recorded
            and progress is made visible over time.
          </p>
          <p>
            The app is currently in beta and completely free to use. Bugs can be
            reported directly, and feature suggestions are welcome.
          </p>
        </div>
        <div>
          <h2>Why did I build it?</h2>
          <p>
            Existing apps were either too complex, too expensive or just didn't
            match the way I train. So I built my own. The goal: as simple as
            possible, as powerful as needed — and completely mine to extend.
          </p>
          <p>
            The app now also includes a full trainer–client module that allows
            personal trainers to share training plans directly with their clients.
          </p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PROCESS ===== -->
    <section class="section">
      <span class="section-label">Development process</span>
      <h2>From idea to live app.</h2>

      <div class="process-steps">
        <div class="process-step">
          <div class="step-head">
            <span class="step-eyebrow">Step 1</span>
            <h3>Wireframe</h3>
          </div>
          <div class="step-body">
            <div class="step-text">
              <p>
                The wireframe laid out the basic structure — how navigation,
                training overview and workout flow are logically arranged.
                Focus: functionality and flow, no design yet. This allowed the
                user journey to be tested early before visual work began.
              </p>
            </div>
            <div class="step-img">
              <img
                src="/images/ys-workout_2.png"
                alt="YS.Workout wireframe"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="process-step">
          <div class="step-head">
            <span class="step-eyebrow">Step 2</span>
            <h3>Mockup</h3>
          </div>
          <div class="step-body">
            <div class="step-text">
              <p>
                The mockup translated the structure into a concrete visual
                design — colours, typography, spacing, layout. It served as the
                foundation for development and helped evaluate the user
                experience before writing a single line of code.
              </p>
            </div>
            <div class="step-img">
              <img
                src="/images/ys-workout_3.png"
                alt="YS.Workout mockup"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="process-step">
          <div class="step-head">
            <span class="step-eyebrow">Step 3</span>
            <h3>Live</h3>
          </div>
          <div class="step-body">
            <div class="step-text">
              <p>
                The app is live and publicly accessible. Currently in beta —
                completely free to use. New features are in continuous
                development, and bugs can be reported directly through the app.
              </p>
              <a
                href="https://workout.yannicksalm.ch"
                target="_blank"
                rel="noopener noreferrer"
                class="step-link"
              >
                workout.yannicksalm.ch ↗
              </a>
            </div>
            <div class="hero-img">
              <img
                src="/images/ys-workout_4.webp"
                alt="YS.Workout live"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== TRAINER MODULE TEASER ===== -->
    <section class="section">
      <span class="section-label">Extension</span>
      <h2>The Trainer Module.</h2>
      <div class="extension-box">
        <div class="extension-text">
          <p>
            YS.Workout now includes a full trainer–client system. Trainers can manage clients,
            build training plans in folders, share them with a single tap, and follow every
            session in a read-only logbook. Clients execute plans directly inside the app —
            all sets logged in real time, trainer notes visible inline.
          </p>
          <p>
            A Cloudflare Worker running on an hourly cron automatically closes stale sessions —
            so neither trainer nor client ever has to clean up manually.
          </p>
        </div>
        <a href="/en/projects/ys-workout-trainer" class="extension-link">
          Read more about the Trainer Module →
        </a>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== RESULT ===== -->
    <section class="section">
      <span class="section-label">Result</span>
      <h2>What came out of it.</h2>
      <div class="result-box">
        <p>
          A fully self-built workout tracking web app — no app store, no
          subscription, no compromises. The app runs reliably, is actively used
          and continuously developed. This project showed me how to go from idea
          through wireframe and mockup all the way to a finished product — and
          what it means to build a real app for real users.
        </p>
        <a
          href="https://workout.yannicksalm.ch/register"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          style="margin-top: 20px; display: inline-flex;"
        >
          Try it for free →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    align-items: start;
    padding: 72px 0 56px;
  }

  .hero-text h1 {
    font-size: clamp(32px, 5vw, 52px);
    margin: 6px 0 18px;
  }
  .hero-desc {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 28px;
  }

  .meta {
    display: flex;
    flex-direction: column;
    margin-bottom: 22px;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 0.5px solid var(--border);
    font-size: 14px;
  }
  .meta-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 64px;
  }
  .meta-link {
    color: var(--accent);
    font-size: 13px;
    transition: opacity var(--trans);
  }
  .meta-link:hover {
    opacity: 0.75;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .hero-img {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 0.5px solid var(--border);
    width: 375px;
    height: 500px;
    flex-shrink: 0;
    align-self: flex-start;
  }
  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Sections */
  .section {
    padding: 56px 0;
  }
  .section h2 {
    margin: 6px 0 20px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .two-col p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 12px;
  }

  /* Process */
  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 24px;
  }

  .process-step {
    padding: 36px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .process-step:last-child {
    border-bottom: none;
  }

  .step-head {
    margin-bottom: 20px;
  }
  .step-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .step-head h3 {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .step-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }

  .step-text p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 14px;
  }

  .step-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    transition: opacity var(--trans);
  }
  .step-link:hover {
    opacity: 0.75;
  }

  .step-img {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 0.5px solid var(--border);
  }
  .step-img img {
    width: 100%;
    display: block;
  }

  /* Extension teaser */
  .extension-box {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 32px;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .extension-text p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 10px;
  }
  .extension-text p:last-child { margin-bottom: 0; }

  .extension-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--accent);
    border: 0.5px solid var(--accent);
    padding: 10px 18px;
    border-radius: var(--radius-sm, 2px);
    transition: opacity var(--trans);
    align-self: flex-start;
  }
  .extension-link:hover { opacity: 0.75; }

  /* Result */
  .result-box {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    max-width: 720px;
  }
  .result-box p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-img {
      order: -1;
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .step-body {
      grid-template-columns: 1fr;
    }
  }
</style>