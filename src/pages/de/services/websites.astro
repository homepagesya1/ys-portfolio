---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="Website erstellen" lang="de">
  <div class="container">

    <a href="/de/services" class="back-link">← Zurück zu Services</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <span class="section-label">Service</span>
      <h1>Website erstellen.</h1>
      <p class="hero-desc">
        Ich entwickle moderne, schnelle und sichere Webseiten für Vereine, kleine Unternehmen
        und Selbstständige — professionell gestaltet, auf allen Geräten optimiert und einfach
        zu verwalten. Von der ersten Idee bis zur fertigen Veröffentlichung begleite ich den
        gesamten Prozess.
      </p>
      <a href="/de/contact" class="btn-primary">Projekt anfragen</a>
    </section>

    <hr class="divider" />

    <!-- ===== FÜR WEN ===== -->
    <section class="section">
      <span class="section-label">Für wen</span>
      <h2>Für wen ist dieser Service?</h2>
      <div class="chip-list" style="margin-top: 16px;">
        <span class="chip">Vereine</span>
        <span class="chip">Kleine Unternehmen</span>
        <span class="chip">Selbstständige</span>
        <span class="chip">Persönliche Projekte</span>
        <span class="chip">Veranstaltungen</span>
        <span class="chip">Portfolio-Websites</span>
      </div>
      <p class="section-text">
        Dieser Service ist für alle gedacht, die eine moderne und übersichtliche Website
        möchten, die nicht nur gut aussieht, sondern auch im Alltag funktioniert. Gerade
        für Vereine, kleine Unternehmen und Selbstständige ist es oft wichtig, eine Lösung
        zu haben, die klar aufgebaut, bezahlbar und langfristig einfach zu pflegen ist.
        Genau darauf lege ich Wert.
      </p>
    </section>

    <hr class="divider" />

    <!-- ===== ENTHALTEN + WARTUNG ===== -->
    <section class="section two-col">

      <div class="panel">
        <span class="section-label">Leistungen</span>
        <h2>Was ist enthalten?</h2>
        <ul class="feature-list">
          <li><span class="fi">⬡</span> Individuelles Webdesign</li>
          <li><span class="fi">◱</span> Mobile-optimiertes Layout</li>
          <li><span class="fi">↯</span> Schnelle Ladezeiten</li>
          <li><span class="fi">◎</span> Suchmaschinen-Grundoptimierung (SEO)</li>
          <li><span class="fi">✎</span> Einfache Inhaltsverwaltung</li>
          <li><span class="fi">◈</span> Hosting-Beratung</li>
          <li><span class="fi">⊕</span> Domain-Einrichtung</li>
          <li><span class="fi">⚿</span> SSL und Sicherheit</li>
        </ul>
      </div>

      <div class="panel">
        <span class="section-label">Optional</span>
        <h2>Wartungsvertrag</h2>
        <p class="section-text">
          Auf Wunsch biete ich zusätzlich einen Wartungsvertrag mit Stunden-Tarif an.
          Dieser eignet sich besonders, wenn nach dem Go-live regelmässig kleinere
          Anpassungen, technische Updates oder Support benötigt werden.
        </p>
        <ul class="feature-list">
          <li><span class="fi">⟳</span> Technische Updates</li>
          <li><span class="fi">✎</span> Anpassungen an Inhalten oder Layout</li>
          <li><span class="fi">⚿</span> Sicherheitsprüfungen</li>
          <li><span class="fi">◉</span> Support bei Fragen oder Problemen</li>
        </ul>
      </div>

    </section>

    <hr class="divider" />

    <!-- ===== ABLAUF ===== -->
    <section class="section">
      <span class="section-label">Prozess</span>
      <h2>Ablauf der Zusammenarbeit</h2>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <div>
            <h3>Anfrage</h3>
            <p>Du beschreibst kurz dein Projekt, deine Ziele und die gewünschten Funktionen.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <div>
            <h3>Planung</h3>
            <p>Gemeinsam definieren wir Struktur, Inhalte und den genauen Umfang der Website.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <div>
            <h3>Entwicklung</h3>
            <p>Ich setze das Design und die technische Struktur sauber und modern um.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <div>
            <h3>Feedback</h3>
            <p>Anpassungen werden auf Basis deines Feedbacks eingearbeitet.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">05</span>
          <div>
            <h3>Veröffentlichung</h3>
            <p>Nach dem Feinschliff wird die Website online gestellt und live geschaltet.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== VORTEILE ===== -->
    <section class="section">
      <span class="section-label">Vorteile</span>
      <h2>Warum bei mir?</h2>
      <div class="benefits-grid">
        <div class="benefit">
          <div class="benefit-icon">⬡</div>
          <h3>Individuelle Lösungen</h3>
          <p>Jede Website wird passend zum Projekt entwickelt — keine Standardlösung von der Stange.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">↯</div>
          <h3>Schnelle Ladezeiten</h3>
          <p>Optimierter Code und moderne Technologien sorgen für eine performante Nutzung.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">◱</div>
          <h3>Mobile-Optimiert</h3>
          <p>Die Website funktioniert zuverlässig auf Smartphone, Tablet und Desktop.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">◉</div>
          <h3>Persönliche Betreuung</h3>
          <p>Direkter Kontakt und kurze Kommunikationswege während des gesamten Projekts.</p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PREISE ===== -->
    <section class="section">
      <span class="section-label">Kosten</span>
      <h2>Preisgestaltung</h2>
      <div class="pricing-text">
        <p>
          Die Kosten hängen immer vom jeweiligen Projekt ab — Umfang, Seitenanzahl,
          gewünschte Funktionen, Designansprüche und allgemeiner Entwicklungsaufwand
          spielen alle eine Rolle.
        </p>
        <p>
          Deshalb lege ich den Preis nicht pauschal fest, sondern beurteile jedes Projekt
          einzeln. Nach einer kurzen Projektanfrage kann ich den Aufwand grob einschätzen
          und eine erste Preisrichtung angeben.
        </p>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <div class="cta-card">
      <div>
        <h2>Interesse an einer eigenen Website?</h2>
        <p>Beschreibe dein Projekt kurz und ich melde mich mit einer ersten Einschätzung.</p>
      </div>
      <a href="/de/contact" class="btn-primary">Anfrage senden</a>
    </div>

  </div>
</BaseLayout>

<style>
  .hero { padding: 72px 0 56px; max-width: 720px; }
  .hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 6px 0 18px; }
  .hero-desc { font-size: 16px; color: var(--muted); line-height: 1.75; margin-bottom: 28px; }

  .section { padding: 56px 0; }
  .section h2 { margin: 6px 0 20px; }
  .section-text { font-size: 15px; color: var(--muted); line-height: 1.75; margin-top: 16px; max-width: 620px; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .panel { }
  .panel h2 { margin: 6px 0 16px; }

  /* Feature list */
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text);
    padding: 10px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .feature-list li:last-child { border-bottom: none; }
  .fi { color: var(--accent); font-size: 13px; flex-shrink: 0; width: 16px; }

  /* Steps */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 20px;
  }
  .step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 20px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .step:last-child { border-bottom: none; }
  .step-num {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    min-width: 28px;
    margin-top: 2px;
  }
  .step h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; letter-spacing: -0.01em; }
  .step p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* Benefits */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 20px;
  }
  .benefit {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px;
  }
  .benefit-icon { font-size: 18px; color: var(--accent); margin-bottom: 10px; }
  .benefit h3 { font-size: 14px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
  .benefit p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* Pricing */
  .pricing-text { max-width: 680px; }
  .pricing-text p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 14px;
  }

  /* CTA */
  .cta-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 32px;
    margin: 48px 0 80px;
  }
  .cta-card h2 { font-size: 22px; margin-bottom: 6px; }
  .cta-card p  { font-size: 14px; color: var(--muted); }

  .chip-list { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 700px) {
    .two-col { grid-template-columns: 1fr; }
    .benefits-grid { grid-template-columns: 1fr; }
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
</style>