---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

type Lang = 'en' | 'de'

interface Props {
  title: string
  description?: string
  lang: Lang
}

const {
  title,
  description = 'Portfolio of Yannick Salm — web creator, developer and IT apprentice from Switzerland.',
  lang,
} = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="cX6oCTTPm3i5UgMX3uBYMSz7mX8SjAlipyUHRTKHicY" />
    <title>{title} | Yannick Salm</title>
    <link rel="icon" type="image/peng" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />

    <!-- No-flash: runs before render, reads saved theme from localStorage -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('ys-theme')
        document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark')
      })()
    </script>
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>