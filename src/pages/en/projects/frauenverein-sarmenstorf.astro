---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Frauenverein Sarmenstorf" lang="en">
    <div class="container">
        <a href="/en/projects" class="back-link">← Back to Projects</a>

        <section class="hero">
            <div class="hero-text">
                <span class="section-label">Project</span>
                <h1>Frauenverein Sarmenstorf</h1>
                <p class="hero-desc">
                    For the Frauenverein Sarmenstorf I got the chance to
                    completely rethink and rebuild their existing website. The
                    goal: a clear, friendly and modern web presence that looks
                    great and is easy to manage in daily use.
                </p>

                <div class="meta">
                    <div class="meta-row">
                        <span class="meta-label">Area</span>
                        <span>Web Design / Development</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Role</span>
                        <span>Concept, Design, Development</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Status</span>
                        <span class="badge badge-live">● Live</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Link</span>
                        <a
                            href="https://frauenverein-sarmenstorf.ch"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="meta-link"
                        >
                            frauenverein-sarmenstorf.ch ↗
                        </a>
                    </div>
                </div>

                <div class="tags">
                    <span class="chip">HTML / CSS</span>
                    <span class="chip">UI / UX</span>
                    <span class="chip">Astro</span>
                </div>
            </div>

            <div class="hero-img">
                <img
                    src="/images/website-frauenverein-sarmenstorf.png"
                    alt="Frauenverein Sarmenstorf website"
                />
            </div>
        </section>

        <hr class="divider" />

        <section class="section">
            <span class="section-label">About the project</span>
            <div class="two-col">
                <div class="info-card">
                    <h3>Starting point</h3>
                    <p>
                        The existing website felt outdated in its structure,
                        design and navigation. Content needed to be presented
                        more clearly and the site needed a more modern,
                        welcoming feel overall.
                    </p>
                </div>
                <div class="info-card">
                    <h3>Goal</h3>
                    <p>
                        A clear, easy to understand and visually appealing
                        website. Key priority: information easy to find for
                        visitors, and the site fully functional on mobile
                        devices.
                    </p>
                </div>
            </div>
        </section>

        <hr class="divider" />

        <section class="section">
            <span class="section-label">What I did</span>
            <h2>How it was built.</h2>
            <div class="features">
                <div class="feature">
                    <span class="feature-num">01</span>
                    <div>
                        <h3>New design</h3>
                        <p>
                            A more modern and calm visual identity that fits the
                            organisation and presents content more clearly.
                        </p>
                    </div>
                </div>
                <div class="feature">
                    <span class="feature-num">02</span>
                    <div>
                        <h3>Restructured navigation</h3>
                        <p>
                            Navigation and page structure were completely
                            rethought so that important information is found
                            faster.
                        </p>
                    </div>
                </div>
                <div class="feature">
                    <span class="feature-num">03</span>
                    <div>
                        <h3>Clean rebuild</h3>
                        <p>
                            Built from scratch with Astro — maintainable
                            long-term, fully responsive and easy to extend.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <hr class="divider" />

        <section class="section">
            <span class="section-label">Before & After</span>
            <h2>Comparison before and after.</h2>
            <div class="ba-grid">
                <a
                    href="https://web.archive.org/web/20240615073649/https://www.frauenverein-sarmenstorf.ch/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ba-card"
                >
                    <div class="ba-header">
                        <h3>Before</h3>
                        <p>
                            The earlier version was functional but visually
                            restrained and less modern in structure.
                        </p>
                    </div>
                    <div class="ba-img">
                        <img
                            src="/images/website-frauenverein-sarmenstorf_old.png"
                            alt="Old Frauenverein website"
                            loading="lazy"
                        />
                    </div>
                    <span class="ba-link">Wayback Machine ↗</span>
                </a>

                <a
                    href="https://frauenverein-sarmenstorf.ch"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ba-card ba-card--featured"
                >
                    <div class="ba-header">
                        <h3>After</h3>
                        <p>
                            The new version is cleaner, more modern and
                            significantly more appealing overall.
                        </p>
                    </div>
                    <div class="ba-img">
                        <img
                            src="/images/website-frauenverein-sarmenstorf_new.png"
                            alt="New Frauenverein website"
                            loading="lazy"
                        />
                    </div>
                    <span class="ba-link">Live website ↗</span>
                </a>
            </div>
        </section>

        <hr class="divider" />

        <section class="section">
            <span class="section-label">Result</span>
            <h2>What the project delivered.</h2>
            <div class="result-box">
                <p>
                    A significantly more modern website with improved
                    navigation, a clearer structure and a more professional
                    presence. The association is better represented online and
                    information is easier to access. This project taught me what
                    a full client process looks like — from the first
                    conversation through to a live launch.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .hero {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 56px;
        align-items: start;
        padding: 72px 0 56px;
    }
    .hero-text h1 {
        font-size: clamp(30px, 5vw, 50px);
        margin: 6px 0 18px;
    }
    .hero-desc {
        font-size: 15px;
        color: var(--muted);
        line-height: 1.75;
        margin-bottom: 28px;
    }

    .meta {
        display: flex;
        flex-direction: column;
        margin-bottom: 22px;
    }
    .meta-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 11px 0;
        border-bottom: 0.5px solid var(--border);
        font-size: 14px;
    }
    .meta-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        min-width: 64px;
    }
    .meta-link {
        color: var(--accent);
        font-size: 13px;
        transition: opacity var(--trans);
    }
    .meta-link:hover {
        opacity: 0.75;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .hero-img {
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 0.5px solid var(--border);
        width: 375px;
        height: 500px;
        flex-shrink: 0;
        align-self: flex-start;
    }
    .hero-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
    }

    .section {
        padding: 56px 0;
    }
    .section h2 {
        margin: 6px 0 24px;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .info-card {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        padding: 24px;
    }
    .info-card h3 {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
        letter-spacing: -0.01em;
    }
    .info-card p {
        font-size: 14px;
        color: var(--muted);
        line-height: 1.7;
    }

    .features {
        display: flex;
        flex-direction: column;
    }
    .feature {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        padding: 20px 0;
        border-bottom: 0.5px solid var(--border);
    }
    .feature:last-child {
        border-bottom: none;
    }
    .feature-num {
        font-family: var(--font-display);
        font-size: 13px;
        font-weight: 700;
        color: var(--accent);
        min-width: 28px;
        margin-top: 2px;
    }
    .feature h3 {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 5px;
        letter-spacing: -0.01em;
    }
    .feature p {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.65;
    }

    .ba-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }
    .ba-card {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        text-decoration: none;
        transition:
            border-color var(--trans),
            transform var(--trans);
    }
    .ba-card:hover {
        border-color: var(--border-md);
        transform: translateY(-2px);
    }
    .ba-card--featured {
        border-color: rgba(201, 168, 124, 0.3);
    }
    .ba-header {
        padding: 20px 20px 14px;
    }
    .ba-header h3 {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .ba-header p {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.6;
    }
    .ba-img {
        overflow: hidden;
    }
    .ba-img img {
        width: 100%;
        display: block;
        transition: transform 0.4s ease;
    }
    .ba-card:hover .ba-img img {
        transform: scale(1.02);
    }
    .ba-link {
        display: block;
        font-size: 12px;
        color: var(--accent);
        padding: 12px 20px;
        font-weight: 500;
    }

    .result-box {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius-md);
        padding: 28px 32px;
        max-width: 720px;
        margin-bottom: 40px;
    }
    .result-box p {
        font-size: 15px;
        color: var(--muted);
        line-height: 1.75;
    }

    @media (max-width: 860px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 32px;
        }
        .hero-img {
            order: -1;
        }
        .two-col {
            grid-template-columns: 1fr;
        }
        .ba-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
