---
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout title="Website Create & Host" lang="en">
  <div class="container">

    <a href="/en/services" class="back-link">← Back to Services</a>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <span class="section-label">Service</span>
      <h1>Website Create & Host.</h1>
      <p class="hero-desc">
        I build modern, fast and secure websites for associations, small businesses and
        freelancers — professionally designed, optimised for all devices and easy to manage.
        From the first idea to the final launch, I guide the entire process.
      </p>
      <a href="/en/contact" class="btn-primary">Request a project</a>
    </section>

    <hr class="divider" />

    <!-- ===== FOR WHOM ===== -->
    <section class="section">
      <span class="section-label">For whom</span>
      <h2>Who is this service for?</h2>
      <div class="chip-list" style="margin-top: 16px;">
        <span class="chip">Associations</span>
        <span class="chip">Small businesses</span>
        <span class="chip">Freelancers</span>
        <span class="chip">Personal projects</span>
        <span class="chip">Events</span>
        <span class="chip">Portfolio sites</span>
      </div>
      <p class="section-text">
        This service is for anyone who wants a modern, clear website that doesn't just
        look good but also works in everyday use. For associations, small businesses and
        freelancers especially, it's important to have a solution that's well-structured,
        affordable and easy to maintain long-term. That's exactly what I focus on.
      </p>
    </section>

    <hr class="divider" />

    <!-- ===== INCLUDED + MAINTENANCE ===== -->
    <section class="section two-col">

      <div class="panel">
        <span class="section-label">What's included</span>
        <h2>What do you get?</h2>
        <ul class="feature-list">
          <li><span class="fi">⬡</span> Custom web design</li>
          <li><span class="fi">◱</span> Mobile-optimised layout</li>
          <li><span class="fi">↯</span> Fast loading times</li>
          <li><span class="fi">◎</span> Basic SEO optimisation</li>
          <li><span class="fi">✎</span> Easy content management</li>
          <li><span class="fi">◈</span> Hosting consultation</li>
          <li><span class="fi">⊕</span> Domain setup</li>
          <li><span class="fi">⚿</span> SSL & security</li>
        </ul>
      </div>

      <div class="panel">
        <span class="section-label">Optional</span>
        <h2>Maintenance contract</h2>
        <p class="section-text">
          On request, I also offer an optional maintenance contract with an hourly rate.
          This is particularly useful when smaller adjustments, technical updates or
          ongoing support are needed after the launch.
        </p>
        <ul class="feature-list">
          <li><span class="fi">⟳</span> Technical updates</li>
          <li><span class="fi">✎</span> Content and layout adjustments</li>
          <li><span class="fi">⚿</span> Security checks</li>
          <li><span class="fi">◉</span> Support for questions or issues</li>
        </ul>
      </div>

    </section>

    <hr class="divider" />

    <!-- ===== PROCESS ===== -->
    <section class="section">
      <span class="section-label">Process</span>
      <h2>How we work together</h2>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <div>
            <h3>Request</h3>
            <p>You briefly describe your project, goals and the features you need.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <div>
            <h3>Planning</h3>
            <p>Together we define structure, content and the exact scope of the website.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <div>
            <h3>Development</h3>
            <p>I build the design and technical structure cleanly and with modern tech.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <div>
            <h3>Feedback</h3>
            <p>Adjustments and improvements are made based on your feedback.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">05</span>
          <div>
            <h3>Launch</h3>
            <p>After final polish, the website goes live and into production.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== BENEFITS ===== -->
    <section class="section">
      <span class="section-label">Why me</span>
      <h2>Why work with me?</h2>
      <div class="benefits-grid">
        <div class="benefit">
          <div class="benefit-icon">⬡</div>
          <h3>Individual solutions</h3>
          <p>Every website is built to fit the project — not a generic template off the shelf.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">↯</div>
          <h3>Fast loading times</h3>
          <p>Optimised code and modern technologies ensure a smooth, performant experience.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">◱</div>
          <h3>Mobile-optimised</h3>
          <p>The website works reliably on smartphone, tablet and desktop.</p>
        </div>
        <div class="benefit">
          <div class="benefit-icon">◉</div>
          <h3>Personal support</h3>
          <p>Direct contact and short communication paths throughout the entire project.</p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ===== PRICING ===== -->
    <section class="section">
      <span class="section-label">Pricing</span>
      <h2>How much does it cost?</h2>
      <div class="pricing-text">
        <p>
          The cost always depends on the specific project — scope, number of pages,
          desired features, design requirements and general development effort all play a role.
        </p>
        <p>
          That's why I don't set a flat price, but assess each project individually.
          After a brief project enquiry, I can give a rough estimate and an initial price range.
        </p>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <div class="cta-card">
      <div>
        <h2>Interested in your own website?</h2>
        <p>Briefly describe your project and I'll get back to you with an initial assessment.</p>
      </div>
      <a href="/en/contact" class="btn-primary">Send request</a>
    </div>

  </div>
</BaseLayout>

<style>
  .hero { padding: 72px 0 56px; max-width: 720px; }
  .hero h1 { font-size: clamp(32px, 5vw, 52px); margin: 6px 0 18px; }
  .hero-desc { font-size: 16px; color: var(--muted); line-height: 1.75; margin-bottom: 28px; }

  .section { padding: 56px 0; }
  .section h2 { margin: 6px 0 20px; }
  .section-text { font-size: 15px; color: var(--muted); line-height: 1.75; margin-top: 16px; max-width: 620px; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }

  .feature-list { display: flex; flex-direction: column; gap: 0; margin-top: 16px; }
  .feature-list li {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; color: var(--text);
    padding: 10px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .feature-list li:last-child { border-bottom: none; }
  .fi { color: var(--accent); font-size: 13px; flex-shrink: 0; width: 16px; }

  .steps { display: flex; flex-direction: column; margin-top: 20px; }
  .step {
    display: flex; gap: 24px; align-items: flex-start;
    padding: 20px 0;
    border-bottom: 0.5px solid var(--border);
  }
  .step:last-child { border-bottom: none; }
  .step-num { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--accent); min-width: 28px; margin-top: 2px; }
  .step h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; letter-spacing: -0.01em; }
  .step p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 20px; }
  .benefit { background: var(--surface); border: 0.5px solid var(--border); border-radius: var(--radius-md); padding: 22px; }
  .benefit-icon { font-size: 18px; color: var(--accent); margin-bottom: 10px; }
  .benefit h3 { font-size: 14px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }
  .benefit p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  .pricing-text { max-width: 680px; }
  .pricing-text p { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 14px; }

  .cta-card {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    background: var(--surface); border: 0.5px solid var(--border);
    border-radius: var(--radius-md); padding: 28px 32px;
    margin: 48px 0 80px;
  }
  .cta-card h2 { font-size: 22px; margin-bottom: 6px; }
  .cta-card p  { font-size: 14px; color: var(--muted); }

  .chip-list { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 700px) {
    .two-col { grid-template-columns: 1fr; }
    .benefits-grid { grid-template-columns: 1fr; }
    .cta-card { flex-direction: column; align-items: flex-start; }
  }
</style>